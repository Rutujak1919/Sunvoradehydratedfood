# Copy this file to ".env" and fill in your own values before running the server.

# Port the server runs on
PORT=3000

# Owner login credentials (kept exactly as you had them)
OWNER_USERNAME=SunvoraFood
OWNER_PASSWORD=Rabhisha@2009

# Secret key used to sign login tokens
JWT_SECRET=SunvoraFoods_SecretKey_2026_Rabhisha

# ---------- Email settings ----------
OWNER_EMAIL=Sunvoradehydration@gmail.com

# SMTP server that will actually send the emails. Example values below work
# with a Gmail account + an "App Password" (see README.md for how to get one).


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=Sunvoradehydration@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="Sunvora Foods" <Sunvoradehydration@gmail.com>